-- =====================================================================
-- Stars and Stripes — obfuscated core schema (GENERATED from core.sql.tmpl)
-- Edit the template, then:  python -m schema_obfuscation render ...
-- Physical identifiers use the antique-numeral profile; the application never
-- touches these tables directly — only the SECURITY DEFINER sa_* functions
-- below, callable by service_role alone. The schema is private (not exposed
-- through PostgREST) and unreachable by anon/authenticated.
-- Obfuscation hides intent from casual dump readers; it is not access control.
-- =====================================================================

-- Enable extension
CREATE SCHEMA IF NOT EXISTS extensions;
CREATE EXTENSION IF NOT EXISTS "uuid-ossp" WITH SCHEMA extensions;

CREATE SCHEMA IF NOT EXISTS {{s}};
REVOKE ALL ON SCHEMA {{s}} FROM PUBLIC;
DO $$ BEGIN
  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'anon') THEN
    EXECUTE 'REVOKE ALL ON SCHEMA {{s}} FROM anon';
  END IF;
  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'authenticated') THEN
    EXECUTE 'REVOKE ALL ON SCHEMA {{s}} FROM authenticated';
  END IF;
END $$;

-- Table: auth_users
CREATE TABLE IF NOT EXISTS {{s}}.{{t:auth_users}} (
    {{c:user_id}} UUID PRIMARY KEY DEFAULT extensions.uuid_generate_v4(),
    {{c:email}} VARCHAR(255) UNIQUE NOT NULL,
    {{c:password_hash}} VARCHAR(255) NOT NULL,
    "role" VARCHAR(50) NOT NULL DEFAULT 'standard_user',
    "is_active" BOOLEAN NOT NULL DEFAULT TRUE,
    "created_at" TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);
-- Additive hardening columns (original columns above are unchanged).
ALTER TABLE {{s}}.{{t:auth_users}}
    ADD COLUMN IF NOT EXISTS {{c:failed_attempts}} INTEGER NOT NULL DEFAULT 0,
    ADD COLUMN IF NOT EXISTS {{c:locked_until}} TIMESTAMP WITH TIME ZONE,
    ADD COLUMN IF NOT EXISTS {{c:last_login_at}} TIMESTAMP WITH TIME ZONE,
    ADD COLUMN IF NOT EXISTS {{c:license_id}} TEXT;
DO $$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'auth_users_role_chk') THEN
    ALTER TABLE {{s}}.{{t:auth_users}} ADD CONSTRAINT auth_users_role_chk CHECK ("role" IN ('standard_user','admin'));
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'auth_users_email_lower_chk') THEN
    ALTER TABLE {{s}}.{{t:auth_users}} ADD CONSTRAINT auth_users_email_lower_chk CHECK ({{c:email}} = lower({{c:email}}));
  END IF;
END $$;

-- Table: licenses (vendor-signed license tokens are verified in the edge function; this tracks seat use)
CREATE TABLE IF NOT EXISTS {{s}}.{{t:licenses}} (
    {{c:license_id}} TEXT PRIMARY KEY,
    {{c:holder}} TEXT NOT NULL,
    {{c:max_accounts}} INTEGER NOT NULL CHECK ({{c:max_accounts}} BETWEEN 1 AND 1000),
    {{c:accounts_used}} INTEGER NOT NULL DEFAULT 0 CHECK ({{c:accounts_used}} >= 0),
    {{c:expires_at}} TIMESTAMP WITH TIME ZONE,
    {{c:revoked_at}} TIMESTAMP WITH TIME ZONE,
    "created_at" TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT licenses_seats_chk CHECK ({{c:accounts_used}} <= {{c:max_accounts}})
);

-- Table: sessions (only a SHA-256 of the opaque bearer token is stored)
CREATE TABLE IF NOT EXISTS {{s}}.{{t:sessions}} (
    {{c:session_id}} UUID PRIMARY KEY DEFAULT extensions.uuid_generate_v4(),
    {{c:token_hash}} BYTEA UNIQUE NOT NULL,
    {{c:user_id}} UUID NOT NULL REFERENCES {{s}}.{{t:auth_users}}({{c:user_id}}) ON DELETE CASCADE,
    "created_at" TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    {{c:expires_at}} TIMESTAMP WITH TIME ZONE NOT NULL,
    {{c:last_seen_at}} TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,
    {{c:revoked_at}} TIMESTAMP WITH TIME ZONE
);
CREATE INDEX IF NOT EXISTS idx_obf_sessions_user ON {{s}}.{{t:sessions}}({{c:user_id}});

-- Table: retrieval_records
-- NOTE: owner FK is ON DELETE CASCADE (was SET NULL). With SET NULL a deleted
-- account's private rows would become owner-less, i.e. visible to every account.
CREATE TABLE IF NOT EXISTS {{s}}.{{t:retrieval_records}} (
    {{c:record_id}} UUID PRIMARY KEY DEFAULT extensions.uuid_generate_v4(),
    {{c:owner_id}} UUID REFERENCES {{s}}.{{t:auth_users}}({{c:user_id}}) ON DELETE CASCADE, -- NULL = shared corpus
    {{c:source_origin}} VARCHAR(100) NOT NULL,
    {{c:category}} VARCHAR(100) NOT NULL,
    {{c:payload}} JSONB NOT NULL DEFAULT '{}'::jsonb,
    "search_vector" TSVECTOR,
    "created_at" TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Indexing using symbol columns
CREATE INDEX IF NOT EXISTS idx_obf_payload ON {{s}}.{{t:retrieval_records}} USING gin ({{c:payload}});
CREATE INDEX IF NOT EXISTS idx_obf_owner ON {{s}}.{{t:retrieval_records}}({{c:owner_id}});
CREATE INDEX IF NOT EXISTS idx_obf_search ON {{s}}.{{t:retrieval_records}} USING gin ("search_vector");
CREATE UNIQUE INDEX IF NOT EXISTS idx_obf_record_identity ON {{s}}.{{t:retrieval_records}}
    ((coalesce({{c:owner_id}}, '00000000-0000-0000-0000-000000000000'::uuid)), (({{c:payload}}->>'id')));

CREATE OR REPLACE FUNCTION {{s}}.retrieval_vector() RETURNS trigger
LANGUAGE plpgsql SET search_path = '' AS $$
BEGIN
  NEW."search_vector" := to_tsvector('english',
    coalesce(NEW.{{c:payload}}->>'title','') || ' ' || coalesce(NEW.{{c:payload}}->>'text',''));
  RETURN NEW;
END $$;
DROP TRIGGER IF EXISTS retrieval_vector_trg ON {{s}}.{{t:retrieval_records}};
CREATE TRIGGER retrieval_vector_trg BEFORE INSERT OR UPDATE ON {{s}}.{{t:retrieval_records}}
    FOR EACH ROW EXECUTE FUNCTION {{s}}.retrieval_vector();

-- Table: audit_log (append-only, hash-chained)
CREATE TABLE IF NOT EXISTS {{s}}.{{t:audit_log}} (
    {{c:event_id}} BIGSERIAL PRIMARY KEY,
    {{c:user_id}} UUID,                      -- deliberately no FK: the trail outlives accounts
    {{c:action}} TEXT NOT NULL,
    {{c:detail}} JSONB NOT NULL DEFAULT '{}'::jsonb,
    {{c:prev_hash}} BYTEA,
    {{c:entry_hash}} BYTEA NOT NULL,
    "created_at" TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE OR REPLACE FUNCTION {{s}}.audit_immutable() RETURNS trigger
LANGUAGE plpgsql SET search_path = '' AS $$
BEGIN RAISE EXCEPTION 'audit_log is append-only' USING ERRCODE = 'SA009'; END $$;
DROP TRIGGER IF EXISTS audit_no_mutation ON {{s}}.{{t:audit_log}};
CREATE TRIGGER audit_no_mutation BEFORE UPDATE OR DELETE ON {{s}}.{{t:audit_log}}
    FOR EACH ROW EXECUTE FUNCTION {{s}}.audit_immutable();
DROP TRIGGER IF EXISTS audit_no_truncate ON {{s}}.{{t:audit_log}};
CREATE TRIGGER audit_no_truncate BEFORE TRUNCATE ON {{s}}.{{t:audit_log}}
    FOR EACH STATEMENT EXECUTE FUNCTION {{s}}.audit_immutable();

-- Defence in depth: RLS on with no policies = non-owner roles see nothing.
ALTER TABLE {{s}}.{{t:auth_users}} ENABLE ROW LEVEL SECURITY;
ALTER TABLE {{s}}.{{t:licenses}} ENABLE ROW LEVEL SECURITY;
ALTER TABLE {{s}}.{{t:sessions}} ENABLE ROW LEVEL SECURITY;
ALTER TABLE {{s}}.{{t:retrieval_records}} ENABLE ROW LEVEL SECURITY;
ALTER TABLE {{s}}.{{t:audit_log}} ENABLE ROW LEVEL SECURITY;

-- =====================================================================
-- Service API (RPC). Clear-text names outside, symbols inside.
-- =====================================================================

-- Registration: seat claim + account creation are one atomic step.
-- The first account on a license is its admin.
CREATE OR REPLACE FUNCTION public.sa_register(
  p_email text, p_password_hash text, p_license_id text, p_holder text,
  p_max_accounts integer, p_expires timestamptz
) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE v_used integer; v_uid uuid; v_role text;
BEGIN
  IF p_expires IS NOT NULL AND p_expires <= now() THEN
    RAISE EXCEPTION 'license_expired' USING ERRCODE = 'SA003';
  END IF;
  INSERT INTO {{s}}.{{t:licenses}} ({{c:license_id}}, {{c:holder}}, {{c:max_accounts}}, {{c:expires_at}})
  VALUES (p_license_id, p_holder, p_max_accounts, p_expires)
  ON CONFLICT ({{c:license_id}}) DO NOTHING;
  UPDATE {{s}}.{{t:licenses}} SET {{c:accounts_used}} = {{c:accounts_used}} + 1
   WHERE {{c:license_id}} = p_license_id AND {{c:revoked_at}} IS NULL
     AND {{c:accounts_used}} < {{c:max_accounts}}
  RETURNING {{c:accounts_used}} INTO v_used;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'license_unavailable' USING ERRCODE = 'SA001';
  END IF;
  v_role := CASE WHEN v_used = 1 THEN 'admin' ELSE 'standard_user' END;
  INSERT INTO {{s}}.{{t:auth_users}} ({{c:email}}, {{c:password_hash}}, "role", {{c:license_id}})
  VALUES (lower(p_email), p_password_hash, v_role, p_license_id)
  RETURNING {{c:user_id}} INTO v_uid;   -- duplicate email raises 23505 and rolls the seat back
  RETURN jsonb_build_object('user_id', v_uid, 'role', v_role);
END $$;

CREATE OR REPLACE FUNCTION public.sa_user_get_by_email(p_email text)
RETURNS jsonb LANGUAGE sql STABLE SECURITY DEFINER SET search_path = '' AS $$
  SELECT jsonb_build_object(
      'user_id', u.{{c:user_id}}, 'email', u.{{c:email}}, 'password_hash', u.{{c:password_hash}},
      'role', u."role", 'is_active', u."is_active",
      'failed_attempts', u.{{c:failed_attempts}}, 'locked_until', u.{{c:locked_until}})
    FROM {{s}}.{{t:auth_users}} u WHERE u.{{c:email}} = lower(p_email);
$$;

CREATE OR REPLACE FUNCTION public.sa_login_failed(p_user uuid, p_max integer DEFAULT 5, p_lock_minutes integer DEFAULT 15)
RETURNS timestamptz LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE v_until timestamptz;
BEGIN
  UPDATE {{s}}.{{t:auth_users}}
     SET {{c:failed_attempts}} = {{c:failed_attempts}} + 1,
         {{c:locked_until}} = CASE WHEN {{c:failed_attempts}} + 1 >= p_max
                                   THEN now() + make_interval(mins => p_lock_minutes)
                                   ELSE {{c:locked_until}} END
   WHERE {{c:user_id}} = p_user
  RETURNING {{c:locked_until}} INTO v_until;
  RETURN v_until;
END $$;

CREATE OR REPLACE FUNCTION public.sa_login_ok(p_user uuid)
RETURNS void LANGUAGE sql SECURITY DEFINER SET search_path = '' AS $$
  UPDATE {{s}}.{{t:auth_users}}
     SET {{c:failed_attempts}} = 0, {{c:locked_until}} = NULL, {{c:last_login_at}} = now()
   WHERE {{c:user_id}} = p_user;
$$;

CREATE OR REPLACE FUNCTION public.sa_set_password(p_user uuid, p_password_hash text)
RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
BEGIN
  UPDATE {{s}}.{{t:auth_users}} SET {{c:password_hash}} = p_password_hash, {{c:failed_attempts}} = 0, {{c:locked_until}} = NULL
   WHERE {{c:user_id}} = p_user;
  UPDATE {{s}}.{{t:sessions}} SET {{c:revoked_at}} = now() WHERE {{c:user_id}} = p_user AND {{c:revoked_at}} IS NULL;
END $$;

CREATE OR REPLACE FUNCTION public.sa_session_create(p_user uuid, p_token_hash bytea, p_ttl_seconds integer DEFAULT 43200, p_max_sessions integer DEFAULT 5)
RETURNS uuid LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE v_sid uuid;
BEGIN
  INSERT INTO {{s}}.{{t:sessions}} ({{c:token_hash}}, {{c:user_id}}, {{c:expires_at}})
  VALUES (p_token_hash, p_user, now() + make_interval(secs => p_ttl_seconds))
  RETURNING {{c:session_id}} INTO v_sid;
  -- keep only the newest p_max_sessions live sessions per account
  UPDATE {{s}}.{{t:sessions}} SET {{c:revoked_at}} = now()
   WHERE {{c:session_id}} IN (
     SELECT {{c:session_id}} FROM {{s}}.{{t:sessions}}
      WHERE {{c:user_id}} = p_user AND {{c:revoked_at}} IS NULL
      ORDER BY "created_at" DESC OFFSET p_max_sessions);
  RETURN v_sid;
END $$;

CREATE OR REPLACE FUNCTION public.sa_session_get(p_token_hash bytea, p_idle_seconds integer DEFAULT 28800)
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE r record;
BEGIN
  SELECT s.{{c:session_id}} AS sid, s.{{c:user_id}} AS uid, u.{{c:email}} AS em, u."role" AS rl, s.{{c:last_seen_at}} AS seen
    INTO r
    FROM {{s}}.{{t:sessions}} s
    JOIN {{s}}.{{t:auth_users}} u ON u.{{c:user_id}} = s.{{c:user_id}}
   WHERE s.{{c:token_hash}} = p_token_hash
     AND s.{{c:revoked_at}} IS NULL
     AND s.{{c:expires_at}} > now()
     AND s.{{c:last_seen_at}} > now() - make_interval(secs => p_idle_seconds)
     AND u."is_active";
  IF NOT FOUND THEN RETURN NULL; END IF;
  IF r.seen < now() - interval '60 seconds' THEN
    UPDATE {{s}}.{{t:sessions}} SET {{c:last_seen_at}} = now() WHERE {{c:session_id}} = r.sid;
  END IF;
  RETURN jsonb_build_object('session_id', r.sid, 'user_id', r.uid, 'email', r.em, 'role', r.rl);
END $$;

CREATE OR REPLACE FUNCTION public.sa_session_revoke(p_token_hash bytea)
RETURNS void LANGUAGE sql SECURITY DEFINER SET search_path = '' AS $$
  UPDATE {{s}}.{{t:sessions}} SET {{c:revoked_at}} = now() WHERE {{c:token_hash}} = p_token_hash AND {{c:revoked_at}} IS NULL;
$$;

CREATE OR REPLACE FUNCTION public.sa_session_revoke_all(p_user uuid)
RETURNS void LANGUAGE sql SECURITY DEFINER SET search_path = '' AS $$
  UPDATE {{s}}.{{t:sessions}} SET {{c:revoked_at}} = now() WHERE {{c:user_id}} = p_user AND {{c:revoked_at}} IS NULL;
$$;

CREATE OR REPLACE FUNCTION public.sa_purge_expired()
RETURNS integer LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE n integer;
BEGIN
  DELETE FROM {{s}}.{{t:sessions}}
   WHERE {{c:expires_at}} < now() - interval '30 days' OR {{c:revoked_at}} < now() - interval '30 days';
  GET DIAGNOSTICS n = ROW_COUNT;
  RETURN n;
END $$;

-- Corpus import (shared corpus when p_owner IS NULL). Idempotent per (owner, payload.id).
CREATE OR REPLACE FUNCTION public.sa_records_upsert(p_owner uuid, p_records jsonb)
RETURNS integer LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE n integer;
BEGIN
  IF jsonb_typeof(p_records) <> 'array' OR jsonb_array_length(p_records) > 500 THEN
    RAISE EXCEPTION 'p_records must be a JSON array of at most 500 items' USING ERRCODE = 'SA010';
  END IF;
  IF EXISTS (
    SELECT 1 FROM jsonb_array_elements(p_records) r
     WHERE jsonb_typeof(r->'payload') <> 'object'
        OR coalesce(r->'payload'->>'id','') = ''
        OR coalesce(r->'payload'->>'title','') = ''
        OR coalesce(r->'payload'->>'url','') NOT LIKE 'https://%'
        OR length(coalesce(r->'payload'->>'text','')) NOT BETWEEN 1 AND 10000
        OR coalesce(r->>'source_origin','') = '' OR coalesce(r->>'category','') = ''
  ) THEN
    RAISE EXCEPTION 'record failed validation (id, title, https url, text 1..10000 chars, source_origin, category)' USING ERRCODE = 'SA010';
  END IF;
  INSERT INTO {{s}}.{{t:retrieval_records}} ({{c:owner_id}}, {{c:source_origin}}, {{c:category}}, {{c:payload}})
  SELECT p_owner, left(r->>'source_origin', 100), left(r->>'category', 100), r->'payload'
    FROM jsonb_array_elements(p_records) r
  ON CONFLICT ((coalesce({{c:owner_id}}, '00000000-0000-0000-0000-000000000000'::uuid)), (({{c:payload}}->>'id')))
  DO UPDATE SET {{c:source_origin}} = EXCLUDED.{{c:source_origin}},
                {{c:category}} = EXCLUDED.{{c:category}},
                {{c:payload}} = EXCLUDED.{{c:payload}};
  GET DIAGNOSTICS n = ROW_COUNT;
  RETURN n;
END $$;

-- Retrieval for the advisor: shared corpus plus the caller's own private records.
CREATE OR REPLACE FUNCTION public.sa_records_search(p_user uuid, p_query text, p_jurisdiction text DEFAULT NULL, p_limit integer DEFAULT 4)
RETURNS jsonb LANGUAGE sql STABLE SECURITY DEFINER SET search_path = '' AS $$
  SELECT coalesce(jsonb_agg(x.pl), '[]'::jsonb) FROM (
    SELECT r.{{c:payload}} AS pl
      FROM {{s}}.{{t:retrieval_records}} r
     WHERE r."search_vector" @@ websearch_to_tsquery('english', left(p_query, 1000))
       AND (r.{{c:owner_id}} IS NULL OR r.{{c:owner_id}} = p_user)
       AND (p_jurisdiction IS NULL OR lower(r.{{c:payload}}->>'jurisdiction') = lower(p_jurisdiction))
     ORDER BY ts_rank(r."search_vector", websearch_to_tsquery('english', left(p_query, 1000))) DESC
     LIMIT greatest(1, least(p_limit, 8))
  ) x;
$$;

-- Tamper-evident audit trail.
CREATE OR REPLACE FUNCTION public.sa_audit(p_user uuid, p_action text, p_detail jsonb DEFAULT '{}'::jsonb)
RETURNS bigint LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE v_prev bytea; v_ts timestamptz := clock_timestamp(); v_id bigint; v_hash bytea;
BEGIN
  PERFORM pg_advisory_xact_lock(727274);
  SELECT a.{{c:entry_hash}} INTO v_prev FROM {{s}}.{{t:audit_log}} a ORDER BY a.{{c:event_id}} DESC LIMIT 1;
  v_hash := sha256(convert_to(
      coalesce(encode(v_prev, 'hex'), '') || '|' || coalesce(p_user::text, '') || '|' || p_action || '|' ||
      p_detail::text || '|' || to_char(v_ts AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.US'), 'UTF8'));
  INSERT INTO {{s}}.{{t:audit_log}} ({{c:user_id}}, {{c:action}}, {{c:detail}}, {{c:prev_hash}}, {{c:entry_hash}}, "created_at")
  VALUES (p_user, p_action, p_detail, v_prev, v_hash, v_ts)
  RETURNING {{c:event_id}} INTO v_id;
  RETURN v_id;
END $$;

CREATE OR REPLACE FUNCTION public.sa_audit_verify()
RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path = '' AS $$
DECLARE r record; v_prev bytea := NULL; v_expect bytea; v_count bigint := 0;
BEGIN
  FOR r IN SELECT * FROM {{s}}.{{t:audit_log}} ORDER BY {{c:event_id}} LOOP
    v_expect := sha256(convert_to(
        coalesce(encode(v_prev, 'hex'), '') || '|' || coalesce(r.{{c:user_id}}::text, '') || '|' || r.{{c:action}} || '|' ||
        r.{{c:detail}}::text || '|' || to_char(r."created_at" AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.US'), 'UTF8'));
    IF r.{{c:prev_hash}} IS DISTINCT FROM v_prev OR r.{{c:entry_hash}} <> v_expect THEN
      RETURN jsonb_build_object('ok', false, 'first_bad_event', r.{{c:event_id}}, 'checked', v_count);
    END IF;
    v_prev := r.{{c:entry_hash}};
    v_count := v_count + 1;
  END LOOP;
  RETURN jsonb_build_object('ok', true, 'checked', v_count);
END $$;

-- Only service_role may call the service API.
DO $$ DECLARE f record; BEGIN
  FOR f IN SELECT p.oid::regprocedure AS sig FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
            WHERE n.nspname = 'public' AND p.proname LIKE 'sa\_%' LOOP
    EXECUTE format('REVOKE ALL ON FUNCTION %s FROM PUBLIC', f.sig);
    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'anon') THEN
      EXECUTE format('REVOKE ALL ON FUNCTION %s FROM anon, authenticated', f.sig);
    END IF;
    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'service_role') THEN
      EXECUTE format('GRANT EXECUTE ON FUNCTION %s TO service_role', f.sig);
    END IF;
  END LOOP;
END $$;
